              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Role is always CUSTOMER.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Swami\",\n  \"email\": \"swami@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login customer (saves token)",
          "request": {
            "method": "POST",
            "header": [
              {
